{
  "name": "agent-tool-call-tracer",
  "version": "1.0.0",
  "description": "Logs every tool call of Claude Code and Google Antigravity to a local SQLite database.",
  "keywords": [
    "agent",
    "logging",
    "tracing",
    "claude-code",
    "antigravity",
    "agy",
    "hooks"
  ],
  "author": "Martin Winkler",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martin-winkler-dev/agent-tool-call-tracer.git"
  },
  "bugs": {
    "url": "https://github.com/martin-winkler-dev/agent-tool-call-tracer/issues"
  },
  "homepage": "https://github.com/martin-winkler-dev/agent-tool-call-tracer#readme",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci --error-on-warnings .",
    "check": "bun run lint:ci && bun run typecheck && bun run test",
    "fill": "bun hooks/agent-tool-call-tracer.ts --fill"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.12.0",
    "typescript": "^7.0.2"
  }
}
